import os
import json
import tempfile
from pathlib import Path
from b2sdk.v2 import B2Api, InMemoryAccountInfo

# ligar ao Backblaze
B2_KEY_ID = os.getenv("B2_KEY_ID")
B2_APP_KEY = os.getenv("B2_APP_KEY")
B2_BUCKET_NAME = os.getenv("B2_BUCKET_NAME")

account_info = InMemoryAccountInfo()
b2_api = B2Api(account_info)
b2_api.authorize_account("production", B2_KEY_ID, B2_APP_KEY)
bucket = b2_api.get_bucket_by_name(B2_BUCKET_NAME)


def list_incoming_json():
    files = bucket.ls(prefix="incoming/")
    return [f for f in files if f[0].file_name.endswith(".json")]


def download_to_temp(file_name: str) -> Path:
    file_info, file_stream = bucket.download_file_by_name(file_name)
    tmp = Path(tempfile.mkdtemp())
    local = tmp / Path(file_name).name
    with open(local, "wb") as f:
        f.write(file_stream.read())
    return local


def upload_file(local_path: Path, remote_path: str, content_type: str):
    with open(local_path, "rb") as f:
        data = f.read()
    bucket.upload_bytes(data, file_name=remote_path, content_type=content_type)


def move_file(old: str, new: str):
    file_info, _ = bucket.download_file_by_name(old)
    bucket.copy(file_info.id_, new_file_name=new, destination_bucket=bucket)
    bucket.delete_file_version(file_info.id_, old)


json_files = list_incoming_json()

if not json_files:
    print("Sem vídeos pendentes.")
else:
    for file_info, _ in json_files:
        json_name = file_info.file_name
        meta_path = download_to_temp(json_name)
        meta = json.loads(meta_path.read_text())

        video_id = meta["video_id"]
        user_email = meta["user_email"]

        video_name = f"incoming/{video_id}.mp4"
